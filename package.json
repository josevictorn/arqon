{
  "name": "arqon-boilerplate",
  "version": "0.0.0",
  "private": true,
  "description": "SaaS boilerplate: NestJS + Fastify, DDD and polyglot CQRS",
  "license": "UNLICENSED",
  "scripts": {
    "arch:check": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "build": "nest build",
    "commitlint": "commitlint",
    "dev": "nest start --watch",
    "format": "biome format --write",
    "infra:down": "docker compose --profile full down",
    "infra:reset": "docker compose --profile full down --volumes --remove-orphans",
    "infra:up": "docker compose --profile core up -d --wait",
    "infra:up:full": "docker compose --profile full up -d --wait",
    "init:project": "node scripts/init-project.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "lefthook install || true",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "test:int": "vitest run --project int --passWithNoTests",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm arch:check && pnpm test:cov"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "fastify": "5.12.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "chokidar": "5.0.0",
    "dependency-cruiser": "18.6.0",
    "lefthook": "2.2.2",
    "typescript": "5.9.3",
    "ultracite": "8.1.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  }
}
