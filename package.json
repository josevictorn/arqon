{
  "name": "arqon-boilerplate",
  "version": "0.0.0",
  "private": true,
  "description": "SaaS boilerplate: NestJS + Fastify, DDD and polyglot CQRS",
  "license": "UNLICENSED",
  "scripts": {
    "arch:check": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "build": "nest build",
    "commitlint": "commitlint",
    "dev": "nest start --watch",
    "format": "biome format --write",
    "infra:down": "docker compose --profile full down",
    "infra:reset": "docker compose --profile full down --volumes --remove-orphans",
    "infra:up": "docker compose --profile core up -d --wait",
    "infra:up:full": "docker compose --profile full up -d --wait",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "lefthook install || true",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "test:int": "vitest run --project int --passWithNoTests",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm arch:check && pnpm test:unit"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "fastify": "5.12.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "chokidar": "6.0.0",
    "dependency-cruiser": "18.7.0",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "ultracite": "8.1.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  }
}
