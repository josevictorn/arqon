# ─────────────────────────────────────────────────────────────────────────────
# Environment template. Copy to `.env` (or run `pnpm init:project` — T1.09,
# which also generates the secrets marked "generated").
# `docker compose` reads `.env` automatically: APP_SLUG names the project and
# the *_PORT vars below define the host ports (ADR-0011 / ADR-0012).
# Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME="Arqon"
APP_SLUG=arqon
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Databases & Cache (profile `core`) ─────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arqon
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arqon?schema=public
# Single-node replica set `rs0`; directConnection avoids resolving member hosts.
MONGODB_URI=mongodb://localhost:27017/arqon?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# ─── Messaging (profile `messaging` — ADR-0004 / ADR-0020 / ADR-0021) ───────
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8081
REDPANDA_CONSOLE_PORT=8080

KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ─── Auth, JWT Ed25519 & MFA (`iam` — ADR-0015) ─────────────────────────────
# Generated per project by `pnpm init:project` (T1.09). Never reuse keys
# across projects. Manual generation (Node 24):
#   node -e "const {generateKeyPairSync:g}=require('node:crypto');const k=g('ed25519');const b=(s)=>Buffer.from(s).toString('base64');console.log('JWT_PRIVATE_KEY='+b(k.privateKey.export({type:'pkcs8',format:'pem'})));console.log('JWT_PUBLIC_KEY='+b(k.publicKey.export({type:'spki',format:'pem'})))"
JWT_KEY_ID=
# Ed25519 private key, PKCS#8 PEM encoded as single-line base64 (generated).
JWT_PRIVATE_KEY=
# Ed25519 public key, SPKI PEM encoded as single-line base64 (generated).
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 32 bytes hex (64 chars) for AES-256-GCM of TOTP secrets (generated):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# ─── Storage & Mail (profile `mail-storage` — ADR-0021) ─────────────────────
S3_PORT=9000
S3_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=arqon-files
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Arqon <no-reply@arqon.local>"

# ─── Billing & Payment Gateways (`billing` — ADR-0005 / ADR-0018) ───────────
PAYMENT_DEFAULT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# ─── Observability & Audit (profile `observability` / `audit` — ADR-0006 / ADR-0013)
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# debug | info | warn | error | fatal | silent (ADR-0013: info in prod, silent in test)
LOG_LEVEL=info
# Sampling of fast GET/HEAD 2xx only; commands, errors and slow requests are 100% kept.
LOG_READ_SAMPLE_RATE=1.0
LOG_SLOW_THRESHOLD_MS=500
OTEL_SERVICE_NAME=arqon-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PERSONAL_SECURITY_LOG_RETENTION_DAYS=90
