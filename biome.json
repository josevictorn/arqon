{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/nestjs"],
  "files": {
    "includes": ["!!test/architecture/fixtures"]
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off",
        "useThisInClassMethods": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["docker/mongo/**/*.js"],
      "javascript": {
        "globals": ["db", "quit", "rs"]
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
